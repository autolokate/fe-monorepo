{
  "name": "@autolokate/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint .",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node ./scripts/garage-contract-check.mjs && pnpm exec vitest run --config vitest.config.ts",
    "test:contract": "node ./scripts/garage-contract-check.mjs",
    "test:unit": "pnpm exec vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@autolokate/auth": "workspace:*",
    "@autolokate/types": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
