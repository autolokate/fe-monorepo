# Onboarding PWA environment (copy to .env.local for local overrides)
# .env.local is gitignored — never commit secrets here.

# Required — backend base URL (no trailing slash)
VITE_API_BASE_URL=https://malisa-noninclusive-davin.ngrok-free.dev

# development | staging | production
VITE_ENVIRONMENT=development

# Enable auth/service debug logs in the browser console
VITE_ENABLE_LOGS=true

# Razorpay publishable key (key_id only — key_secret stays on the backend, never in the PWA)
# VITE_RAZORPAY_KEY=rzp_test_xxxxxxxx
