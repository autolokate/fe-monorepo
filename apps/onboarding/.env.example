# Onboarding PWA — copy this file once for local development:
#   cp .env.example .env.development
#
# Vite loads `.env.development` when you run `pnpm dev`.
# Production builds load `.env.production` (committed) and/or Vercel env vars.
# Consumer onboarding API — do NOT use apps/website staging (autolokate-api-staging…).
# Set VITE_API_BASE_URL in Vercel when the backend tunnel/host changes.

# Required — backend base URL (no trailing slash)
VITE_API_BASE_URL=https://malisa-noninclusive-davin.ngrok-free.dev

# development | staging | production
VITE_ENVIRONMENT=development

# Enable auth/service debug logs in the browser console
VITE_ENABLE_LOGS=true

# Razorpay publishable key (key_id only — key_secret stays on the backend, never in the PWA)
VITE_RAZORPAY_KEY=rzp_test_T7vT7zqV13HcS2
