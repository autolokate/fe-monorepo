# Copy to `.env.e2e.local` (gitignored) or export in the shell before `pnpm test:e2e`.

E2E_API_BASE_URL=http://127.0.0.1:3000
E2E_ADMIN_BASE_URL=http://127.0.0.1:5174

# Option A — inject an already-minted ADMIN session (preferred for CI / repeat runs)
E2E_ADMIN_ACCESS_TOKEN=
E2E_ADMIN_REFRESH_TOKEN=
E2E_ADMIN_USER_ID=
# E2E_ADMIN_EXPIRES_AT=2026-07-09T20:30:00.000Z

# Option B — real OTP (WhatsApp/SMS). Request OTP first, then set the code.
# E2E_ADMIN_PHONE=8816848066
# E2E_ADMIN_OTP=123456

# SKU label in the create-batch dropdown (default: SKU-B2C-RETAIL from scripts/seed-skus.sql)
# E2E_SKU_CODE=SKU-B2C-RETAIL

# Optional
E2E_BATCH_TOTAL_COUNT=5
# E2E_HEADED=1
# Watch mode (or use `pnpm test:e2e:watch`):
# E2E_PAUSE=1
# E2E_SLOWMO_MS=400
# E2E_STEP_MS=1500
