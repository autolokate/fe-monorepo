# Copy to .env.development for local dev. No committed .env.production — staging/prod inject these at
# build time (CI repo variables), and VITE_API_BASE_URL is required (the app throws if unset).
# Local dev uses the shared ngrok tunnel; override with http://localhost:8080 if running API locally.
VITE_API_BASE_URL=https://malisa-noninclusive-davin.ngrok-free.dev
VITE_ENVIRONMENT=development
VITE_ENABLE_LOGS=true
