# Copy to .env.development for local Vite (`pnpm --filter @autolokate/admin dev`).
# No committed .env.production — staging/prod inject these at build time (CI).
#
# Local Admin MUST target the verified Dev API (FE Actions var AWS_DEV_API_BASE_URL).
# Do NOT point local development at api-staging.autolokate.com — the app throws if you do.
# Override with http://localhost:8080 only when running a local Nest API.
VITE_API_BASE_URL=https://d1wpatcmpyt0pw.cloudfront.net
VITE_ENVIRONMENT=development
VITE_ENABLE_LOGS=true
