# ──────────────────────────────────────────────────────────────
# Autolokate Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# ──────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
# Canonical site URL used for metadata, OG tags, and redirects.
# In production set this to the real domain (e.g. https://autolokate.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Backend API ───────────────────────────────────────────────
# Base URL of the Autolokate API. Staging/prod inject this at build time (CI build args); the code
# defaults to http://localhost:8080 for local dev if unset — never a deployed endpoint.
NEXT_PUBLIC_AUTOLOKATE_API_BASE_URL=http://localhost:8080

# Client-side publishable key loaded by Razorpay.js checkout.
# Must match the Key ID above (same value, different prefix so Next.js
# exposes it to the browser bundle).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
