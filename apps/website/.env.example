# ──────────────────────────────────────────────────────────────
# Autolokate Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# ──────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
# Canonical site URL used for metadata, OG tags, and redirects.
# In production set this to the real domain (e.g. https://autolokate.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Backend API ───────────────────────────────────────────────
# Base URL of the Autolokate API. Staging/prod inject this at build time (CI build args).
# REQUIRED for `next build` — a production build fails if it is unset or not an http(s) URL.
# `next dev` falls back to http://localhost:8080 when unset.
NEXT_PUBLIC_AUTOLOKATE_API_BASE_URL=http://localhost:8080

# Client-side publishable key loaded by Razorpay.js checkout.
# Must match the Key ID above (same value, different prefix so Next.js
# exposes it to the browser bundle).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── App links (runtime, server-only — read per request by /.well-known/*) ──────
# iOS universal links: comma-separated TEAMID.bundleId. Default: 8K33AZH2X2.com.mycompany.indiandriveguide
# (+ .dev, .prodTest).
APP_LINKS_IOS_APP_IDS=
# Android App Links. Default package com.mycompany.indiandriveguide (live Play listing) + the 4 fingerprints
# https://autolokate.com/.well-known/assetlinks.json publishes today.
# TODO(owner): set APP_LINKS_ANDROID_SHA256 from Play Console → Setup → App integrity
# (App signing key certificate SHA-256 + upload key SHA-256), comma-separated AA:BB:… values.
APP_LINKS_ANDROID_PACKAGE=
APP_LINKS_ANDROID_SHA256=
# Optional extra statement for a dev build (fingerprint defaults to the RN debug keystore).
APP_LINKS_ANDROID_DEV_PACKAGE=
APP_LINKS_ANDROID_DEV_SHA256=
