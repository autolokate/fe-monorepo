# ──────────────────────────────────────────────────────────────
# Autolokate Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# ──────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
# Canonical site URL used for metadata, OG tags, and redirects.
# In production set this to the real domain (e.g. https://autolokate.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Backend API ───────────────────────────────────────────────
# Staging/production Autolokate API. Loopback hosts (localhost, 127.0.0.1) are
# ignored at runtime and rewritten to staging so leftover local env files cannot
# silently send traffic to a machine that is not running the API.
NEXT_PUBLIC_AUTOLOKATE_API_BASE_URL=https://api-staging.autolokate.com

# Client-side publishable key loaded by Razorpay.js checkout.
# Must match the Key ID above (same value, different prefix so Next.js
# exposes it to the browser bundle).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
