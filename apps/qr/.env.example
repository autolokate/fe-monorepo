# QR PWA — copy this file once for local development:
#   cp .env.example .env.development
#
# Vite loads `.env.development` when you run `pnpm dev`. There is intentionally NO committed
# .env.production — staging/prod builds inject these at build time (CI repo variables), and
# VITE_API_BASE_URL is required (the app throws if it's unset) so no fallback URL is ever bundled.

# Required — backend base URL (no trailing slash). Point at your local API or a personal tunnel.
VITE_API_BASE_URL=http://localhost:8080

# development | staging | production
VITE_ENVIRONMENT=development

# Enable auth/service debug logs in the browser console
VITE_ENABLE_LOGS=true

# Razorpay publishable key (key_id only — key_secret stays on the backend, never in the PWA)
VITE_RAZORPAY_KEY=rzp_test_T7vT7zqV13HcS2

# Optional — override the QR-sticker entry base host. Defaults to this app's own origin
# (qr-staging.<apex> in staging, qr.<apex> in prod); set only to embed a fixed canonical host.
# VITE_QR_ENTRY_BASE_URL=https://qr.autolokate.com
