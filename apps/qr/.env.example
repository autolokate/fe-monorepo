# QR PWA — copy this file once for local development:
#   cp .env.example .env.development
#
# Vite loads `.env.development` when you run `pnpm dev`. There is intentionally NO committed
# .env.production — staging/prod builds inject these at build time (CI repo variables), and
# VITE_API_BASE_URL is required (the app throws if it's unset) so no fallback URL is ever bundled.

# Required — backend base URL (no trailing slash).
# Local Vite → staging API (CORS allows localhost). Staging/prod: injected at CI build time.
VITE_API_BASE_URL=https://api-staging.autolokate.com

# development | staging | production
VITE_ENVIRONMENT=development

# Enable auth/service debug logs in the browser console
VITE_ENABLE_LOGS=true

# Razorpay publishable key (key_id only — key_secret stays on the backend, never in the PWA)
VITE_RAZORPAY_KEY=rzp_test_T7vT7zqV13HcS2

# Optional — override the QR-sticker entry base host. Defaults to this app's own origin
# (qr-staging.<apex> in staging, qr.<apex> in prod); set only to embed a fixed canonical host.
# VITE_QR_ENTRY_BASE_URL=https://qr.autolokate.com

# Firebase web app (project autolokate-50246) — public client config for FCM device tokens.
# Without these + VITE_FIREBASE_VAPID_KEY, POST /v1/devices/token is skipped (no token).
VITE_FIREBASE_API_KEY=AIzaSyBc722Z077xkcOrpL5PdnlSAnc4w9PqLRo
VITE_FIREBASE_AUTH_DOMAIN=autolokate-50246.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=autolokate-50246
VITE_FIREBASE_STORAGE_BUCKET=autolokate-50246.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1096938366736
VITE_FIREBASE_APP_ID=1:1096938366736:web:c2f1941f7132f2b327e795
VITE_FIREBASE_MEASUREMENT_ID=G-8LF8RBJLR0
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=BP7Uieimlz8ojtzhiTn8174yOwU8aVrMpFuZwJ6GvmSCxK4SsYiCJC4-QEL3AesKENH0Zw_7QeovBtesrUhDlKA


