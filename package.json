{
  "name": "autolokate-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:qr",
    "test:qr": "pnpm --filter @autolokate/qr test:fid",
    "test:admin:e2e": "pnpm --filter @autolokate/admin test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@autolokate/config": "workspace:*",
    "@eslint/js": "^9.29.0",
    "@next/eslint-plugin-next": "^16.2.10",
    "eslint": "^9.29.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.5.3",
    "turbo": "^2.10.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  },
  "engines": {
    "node": ">=24"
  }
}
